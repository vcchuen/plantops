# Copy to .env (git-ignored) and change the value. SQL Server requires 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Change_me_Str0ng!Passw0rd

# Keycloak admin credentials for local development.
KEYCLOAK_ADMIN_PASSWORD=Change_me_Adm1n

# Keycloak client secret for the plantops-web client (development only).
# Must match the secret in deploy/keycloak/plantops-realm.json for local dev.
# In production, this is injected from Azure Key Vault (see docs/guides/entra-id.md).
KEYCLOAK_CLIENT_SECRET=plantops-dev-secret-change-me

# Service Bus emulator connection string (optional).
# Enable with: docker compose --profile messaging up
# When set, SLA breaches are published to the sla-breaches queue for downstream Azure Function processing.
# When empty, breaches are logged locally only (development default).
# For local emulator container on same network:
# SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
