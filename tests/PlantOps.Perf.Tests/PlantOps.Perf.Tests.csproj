<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables; the runner starts them directly. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure logic of the harness (parsers, statistics, seed generator); nothing here needs SQL Server or Docker.
         A tiny project of its own: the other test projects boot the Api host, and the harness is not a module. -->
    <ProjectReference Include="..\..\perf\PlantOps.Perf\PlantOps.Perf.csproj" />
  </ItemGroup>

</Project>
