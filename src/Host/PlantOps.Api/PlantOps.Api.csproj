<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local dev connection string lives here, not in appsettings:
         dotnet user-secrets set "ConnectionStrings:PlantOps" "..." (run in src/Host/PlantOps.Api) -->
    <UserSecretsId>plantops-api-9c1f6a0e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Azure deployment (design 09). All opt-in by configuration; see Hosting/AzureHosting.cs. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <!-- Design-time only: lets `dotnet ef` use this project as the startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlantOps.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\PlantOps.SharedKernel\PlantOps.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Modules\Assets\PlantOps.Modules.Assets\PlantOps.Modules.Assets.csproj" />
    <ProjectReference Include="..\..\Modules\WorkOrders\PlantOps.Modules.WorkOrders\PlantOps.Modules.WorkOrders.csproj" />
    <ProjectReference Include="..\..\Modules\Inventory\PlantOps.Modules.Inventory\PlantOps.Modules.Inventory.csproj" />
    <ProjectReference Include="..\..\Modules\Reporting\PlantOps.Modules.Reporting\PlantOps.Modules.Reporting.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\PlantOps.Modules.Identity\PlantOps.Modules.Identity.csproj" />
  </ItemGroup>

</Project>
